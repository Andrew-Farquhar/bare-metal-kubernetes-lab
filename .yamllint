extends: default

rules:
  document-start: disable
  line-length: disable
  indentation:
    spaces: 2
    indent-sequences: consistent
  braces:
    max-spaces-inside: 1
  empty-lines:
    max: 2
  trailing-spaces: enable
  key-duplicates: enable
  comments:
    min-spaces-from-content: 2
  truthy:
    allowed-values: ['true', 'false', 'on']
